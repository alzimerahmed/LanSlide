{
  "permissions": {
    "allow": [
      "Read(**)",
      "Exec(./gradlew)",
      "Exec(./gradlew assembleDebug)",
      "Exec(./gradlew test)",
      "Exec(./gradlew lint)",
      "Exec(./gradlew clean)",
      "Exec(./gradlew assembleStandardDebug)",
      "Exec(./gradlew assembleStandardfullDebug)",
      "Exec(./gradlew assembleOfflineDebug)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git branch)",
      "Exec(git add)",
      "Exec(git commit)",
      "Exec(git show)",
      "Exec(git stash)",
      "Exec(git checkout)",
      "Exec(git merge)",
      "Exec(adb)",
      "Exec(bundletool)",
      "Exec(java -version)",
      "Exec(kotlin -version)"
    ],
    "ask": [
      "Exec(git push)",
      "Exec(git rebase)",
      "Exec(git reset --hard)",
      "Exec(git clean -fd)",
      "Exec(git tag)",
      "Exec(./gradlew assembleRelease)",
      "Exec(./gradlew bundleRelease)",
      "Exec(fastlane)",
      "Write(build.gradle.kts)",
      "Write(settings.gradle)",
      "Write(gradle.properties)",
      "Write(**/build.gradle.kts)"
    ],
    "deny": [
      "Exec(sudo)",
      "Exec(rm -rf /)",
      "Exec(mkfs)",
      "Exec(shutdown)",
      "Exec(halt)",
      "Write(.env)"
    ]
  }
}
